# Copy to .env and fill in. Both values come from Supabase → Settings → API.
# The publishable/anon key is safe in the client bundle *only because* RLS is on
# for every table. Never put the secret (service_role) key in here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
